  "summary": "Choose two vertical lines that form the container with the largest possible water area.",
  "hint": "Start at both ends, compute the area, and move the shorter side because it limits the height.",
  "quickAnswer": {
    "pattern": "Two Pointers",
    "idea": [
      "Start with widest container.",
      "Area is limited by shorter wall.",
      "Move the shorter wall inward."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Place one pointer at each end of the height array.",
    "Compute the area from the current width and the shorter line.",
    "Keep the best area seen so far.",
    "Move the pointer at the shorter line inward.",
    "Repeat until the pointers meet."
  ],
  "pseudocode": [
    "left = first index",
    "right = last index",
    "best = 0",
    "",
    "while left < right:",
    "    area = width times shorter height",
    "    update best",
    "",
    "    if left height is smaller:",
    "        move left rightward",
    "    else:",
    "        move right leftward",
    "",
    "return best"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "Only two lines are present.",
    "The tallest line is not part of the answer.",
    "Heights are increasing or decreasing.",
    "Many lines have the same height."
