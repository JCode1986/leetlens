  "solutions": {
    "javascript": {
      "desktop": [
        "function climbStairs(n) {",
        "  if (n <= 2) return n;",
        "",
        "  let prev2 = 1;",
        "  let prev1 = 2;",
        "",
        "  for (let step = 3; step <= n; step += 1) {",
        "    const current = prev1 + prev2;",
        "    prev2 = prev1;",
        "    prev1 = current;",
        "  }",
        "",
        "  return prev1;",
        "}"
      ],
