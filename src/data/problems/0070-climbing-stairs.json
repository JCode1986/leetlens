  "summary": "Count how many distinct ways there are to reach the top when each move climbs one or two steps.",
  "hint": "The number of ways to reach a step is the sum of the ways to reach the previous two steps.",
  "quickAnswer": {
    "pattern": "1D Dynamic Programming",
    "idea": [
      "Ways to reach a step equals previous two counts.",
      "Keep only the last two values.",
      "Iterate until the nth step."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Recognize the recurrence ways(n) = ways(n - 1) + ways(n - 2).",
    "Keep only the previous two counts.",
    "Iterate from step three through n.",
    "Update the rolling counts each step.",
    "Return the count for n."
  ],
  "pseudocode": [
    "if n <= 2:",
    "    return n",
    "",
    "oneStep = 1",
    "twoSteps = 2",
    "",
    "for step from 3 to n:",
    "    current = oneStep + twoSteps",
    "    oneStep = twoSteps",
    "    twoSteps = current",
    "",
    "return twoSteps"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "n is 1.",
    "n is 2.",
    "Small values should not enter the loop.",
    "Large n still uses constant memory."
