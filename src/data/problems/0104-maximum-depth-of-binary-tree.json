  "summary": "Compute the number of nodes on the longest path from the root down to any leaf.",
  "hint": "A node's depth is one plus the larger depth of its left and right subtrees.",
  "quickAnswer": {
    "pattern": "DFS Recursion",
    "idea": [
      "An empty tree has depth zero.",
      "Depth is one plus the deeper subtree.",
      "Return the recursive height from root."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(h)"
    }
  },
  "approach": [
    "Return zero when the current node is null.",
    "Recursively compute the left subtree depth.",
    "Recursively compute the right subtree depth.",
    "Return one plus the larger subtree depth.",
    "The root call gives the maximum tree depth."
  ],
  "pseudocode": [
    "depth(node):",
    "    if node is null:",
    "        return 0",
    "",
    "    left = depth(node.left)",
    "    right = depth(node.right)",
    "    return 1 + max(left, right)",
    "",
    "return depth(root)"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(h)"
  },
  "edgeCases": [
    "The tree is empty.",
    "The tree has only one node.",
    "The tree is completely skewed.",
    "The deepest path is on the right subtree.",
    "Both subtrees have the same height."
  ],
  "solutions": {
    "javascript": {
      "desktop": [
        "function maxDepth(root) {",
        "  if (root === null) {",
        "    return 0;",
        "  }",
        "",
        "  return 1 + Math.max(maxDepth(root.left), maxDepth(root.right));",
        "}"
      ],
