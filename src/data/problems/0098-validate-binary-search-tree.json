  "summary": "Determine whether a binary tree satisfies the strict ordering rules of a binary search tree.",
  "hint": "Each node must fit inside a lower and upper bound inherited from its ancestors.",
  "quickAnswer": {
    "pattern": "BST Bounds",
    "idea": [
      "Each node must stay within min and max bounds.",
      "Left children tighten the upper bound.",
      "Right children tighten the lower bound."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(h)"
    }
  },
  "approach": [
    "Run a DFS that carries the valid numeric range for each node.",
    "Reject a node if it is not strictly between its bounds.",
    "For the left child, tighten the upper bound to the current value.",
    "For the right child, tighten the lower bound to the current value.",
    "An empty subtree is valid."
  ],
  "pseudocode": [
    "validate(node, low, high):",
    "    if node is null:",
    "        return true",
    "    if value not between bounds:",
    "        return false",
    "",
    "    return validate left with high = value",
    "        and validate right with low = value",
    "",
    "return validate(root, -infinity, infinity)"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(h)"
  },
  "edgeCases": [
    "The tree is empty.",
    "A duplicate value appears.",
    "A deep descendant violates an ancestor bound.",
    "The tree is highly skewed."
