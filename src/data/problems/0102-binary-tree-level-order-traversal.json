    "javascript": {
      "desktop": [
        "function levelOrder(root) {",
        "  if (!root) return [];",
        "  const result = [];",
        "  const queue = [root];",
        "",
        "  for (let head = 0; head < queue.length;) {",
        "    const size = queue.length - head;",
        "    const level = [];",
        "    for (let i = 0; i < size; i += 1) {",
        "      const node = queue[head++];",
        "      level.push(node.val);",
        "      if (node.left) queue.push(node.left);",
        "      if (node.right) queue.push(node.right);",
        "    }",
        "    result.push(level);",
        "  }",
        "",
        "  return result;",
        "}"
      ],
