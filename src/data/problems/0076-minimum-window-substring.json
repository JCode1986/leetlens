        "class Solution:",
        "    def minWindow(self, s, t):",
        "        need = Counter(t); missing = len(t); left = 0; best = (0, float('inf'))",
        "        for right, ch in enumerate(s):",
        "            if ch in need:",
        "                if need[ch] > 0: missing -= 1",
        "                need[ch] -= 1",
        "            while missing == 0:",
        "                if right - left + 1 < best[1]: best = (left, right - left + 1)",
