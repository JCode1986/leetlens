      "desktop": [
        "function minWindow(s, t) {",
        "  const need = new Map(); for (const ch of t) need.set(ch, (need.get(ch) || 0) + 1);",
        "  let missing = t.length, left = 0, best = [0, Infinity];",
        "  for (let right = 0; right < s.length; right += 1) { const ch = s[right]; if (need.has(ch)) { if (need.get(ch) > 0) missing -= 1; need.set(ch, need.get(ch) - 1); } while (missing === 0) { if (right - left + 1 < best[1]) best = [left, right - left + 1]; const out = s[left++]; if (need.has(out)) { need.set(out, need.get(out) + 1); if (need.get(out) > 0) missing += 1; } } }",
        "  return best[1] === Infinity ? '' : s.slice(best[0], best[0] + best[1]);",
        "}"
