      "desktop": [
        "class Solution { public String minWindow(String s, String t) { int[] need = new int[128]; for (char ch : t.toCharArray()) need[ch]++; int missing = t.length(), left = 0, start = 0, len = Integer.MAX_VALUE; for (int right = 0; right < s.length(); right++) { if (need[s.charAt(right)]-- > 0) missing--; while (missing == 0) { if (right - left + 1 < len) { start = left; len = right - left + 1; } if (++need[s.charAt(left++)] > 0) missing++; } } return len == Integer.MAX_VALUE ? \"\" : s.substring(start, start + len); } }"
