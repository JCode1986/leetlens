        "class Solution:",
        "    def longestPalindrome(self, s):",
        "        best_start = 0",
        "        best_len = 0",
        "        def expand(left, right):",
        "            nonlocal best_start, best_len",
        "            while left >= 0 and right < len(s) and s[left] == s[right]:",
        "                left -= 1",
        "                right += 1",
        "            size = right - left - 1",
        "            if size > best_len:",
