  "pseudocode": [
    "minPrice = infinity",
    "best = 0",
    "",
    "for each price:",
    "    minPrice = min(minPrice, price)",
    "    profit = price - minPrice",
    "    best = max(best, profit)",
    "",
    "return best"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
