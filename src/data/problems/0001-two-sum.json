  "approach": [
    "Create a hash map from value to index.",
    "Scan the array once from left to right.",
    "For each number, compute target minus that number.",
    "Return the stored index and current index when the complement exists.",
    "Otherwise store the current value and continue."
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "edgeCases": [
    "The answer uses the same numeric value twice at different indices.",
