  "solutions": {
    "javascript": {
      "desktop": [
        "function twoSum(nums, target) {",
        "  const seen = new Map();",
        "",
        "  for (let i = 0; i < nums.length; i += 1) {",
        "    const needed = target - nums[i];",
        "",
        "    if (seen.has(needed)) {",
        "      return [seen.get(needed), i];",
        "    }",
        "",
        "    seen.set(nums[i], i);",
        "  }",
        "",
        "  return [];",
        "}"
      ],
