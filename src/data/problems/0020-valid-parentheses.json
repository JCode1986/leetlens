  "summary": "Decide whether every opening bracket is closed by the same type of bracket in the correct order.",
  "hint": "The most recent unmatched opening bracket must match the next closing bracket.",
  "approach": [
    "Create a stack for opening brackets.",
    "Push each opening bracket as it appears.",
    "For each closing bracket, reject if the stack is empty.",
    "Pop the latest opener and verify that it matches the closer.",
    "Accept only if no openers remain at the end."
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "edgeCases": [
    "The string length is odd.",
