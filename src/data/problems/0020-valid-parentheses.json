  "solutions": {
    "javascript": {
      "desktop": [
        "function isValid(s) {",
        "  const pairs = new Map([",
        "    [')', '('],",
        "    [']', '['],",
        "    ['}', '{'],",
        "  ]);",
        "  const stack = [];",
        "",
        "  for (const char of s) {",
        "    if (!pairs.has(char)) {",
        "      stack.push(char);",
        "      continue;",
        "    }",
        "",
        "    if (stack.pop() !== pairs.get(char)) {",
        "      return false;",
        "    }",
        "  }",
        "",
        "  return stack.length === 0;",
        "}"
      ],
