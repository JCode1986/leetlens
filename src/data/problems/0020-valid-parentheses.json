    "python": {
      "desktop": [
        "class Solution:",
        "    def isValid(self, s: str) -> bool:",
        "        pairs = {')': '(', ']': '[', '}': '{'}",
        "        stack = []",
        "",
        "        for char in s:",
        "            if char not in pairs:",
        "                stack.append(char)",
        "                continue",
        "",
        "            if not stack or stack.pop() != pairs[char]:",
        "                return False",
        "",
        "        return not stack"
      ],
