    "java": {
      "desktop": [
        "class Solution {",
        "    public boolean isValid(String s) {",
        "        Deque<Character> stack = new ArrayDeque<>();",
        "",
        "        for (char ch : s.toCharArray()) {",
        "            if (ch == '(' || ch == '[' || ch == '{') {",
        "                stack.push(ch);",
        "            } else if (stack.isEmpty()) {",
        "                return false;",
        "            } else {",
        "                char open = stack.pop();",
        "                if ((ch == ')' && open != '(') ||",
        "                    (ch == ']' && open != '[') ||",
        "                    (ch == '}' && open != '{')) {",
        "                    return false;",
        "                }",
        "            }",
        "        }",
        "",
        "        return stack.isEmpty();",
        "    }",
        "}"
      ],
