  },
  "approach": [
    "Set left and right bounds around the whole array.",
    "Compute the middle index without overflowing.",
    "Return the middle index if it matches the target.",
    "Move left or right based on the comparison.",
    "Return -1 when the bounds cross."
  ],
  "pseudocode": [
    "left = 0",
    "right = last index",
    "",
    "while left <= right:",
    "    mid = middle index",
    "    if nums[mid] is target:",
    "        return mid",
    "    if nums[mid] < target:",
    "        left = mid + 1",
    "    else:",
    "        right = mid - 1",
    "",
    "return -1"
