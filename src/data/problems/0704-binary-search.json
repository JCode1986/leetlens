        "        while left <= right:",
        "            mid = left + (right - left) // 2",
        "            if nums[mid] == target:",
        "                return mid",
        "            if nums[mid] < target:",
        "                left = mid + 1",
        "            else:",
        "                right = mid - 1",
        "",
        "        return -1"
