      "desktop": [
        "function canJump(nums) {",
        "  let reach = 0;",
        "  for (let i = 0; i < nums.length; i += 1) { if (i > reach) return false; reach = Math.max(reach, i + nums[i]); }",
        "  return true;",
        "}"
