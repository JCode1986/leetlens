    "javascript": {
      "desktop": [
        "function canFinish(numCourses, prerequisites) { const graph = Array.from({ length: numCourses }, () => []); const indeg = Array(numCourses).fill(0); for (const [a, b] of prerequisites) { graph[b].push(a); indeg[a] += 1; } const q = []; for (let i = 0; i < numCourses; i += 1) if (indeg[i] === 0) q.push(i); let seen = 0; for (let h = 0; h < q.length; h += 1) { seen += 1; for (const next of graph[q[h]]) if (--indeg[next] === 0) q.push(next); } return seen === numCourses; }"
