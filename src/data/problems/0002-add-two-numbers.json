    "javascript": {
      "desktop": [
        "function addTwoNumbers(l1, l2) {",
        "  const dummy = new ListNode(0);",
        "  let cur = dummy;",
        "  let carry = 0;",
        "  while (l1 || l2 || carry) {",
        "    const sum = (l1 ? l1.val : 0) + (l2 ? l2.val : 0) + carry;",
        "    carry = Math.floor(sum / 10);",
        "    cur.next = new ListNode(sum % 10);",
        "    cur = cur.next;",
        "    if (l1) l1 = l1.next;",
        "    if (l2) l2 = l2.next;",
        "  }",
        "  return dummy.next;",
        "}"
      ],
