      "desktop": [
        "function mergeKLists(lists) {",
        "  function merge(a, b) {",
        "    const dummy = new ListNode(0);",
        "    let tail = dummy;",
        "    while (a && b) { if (a.val <= b.val) { tail.next = a; a = a.next; } else { tail.next = b; b = b.next; } tail = tail.next; }",
        "    tail.next = a || b;",
        "    return dummy.next;",
        "  }",
        "  let result = null;",
        "  for (const list of lists) result = merge(result, list);",
        "  return result;",
        "}"
