    "javascript": {
      "desktop": [
        "function maxSubArray(nums) {",
        "  let best = nums[0], current = nums[0];",
        "  for (let i = 1; i < nums.length; i += 1) { current = Math.max(nums[i], current + nums[i]); best = Math.max(best, current); }",
        "  return best;",
        "}"
      ],
