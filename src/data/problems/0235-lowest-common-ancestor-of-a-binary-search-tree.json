  "summary": "Find the lowest node in a BST that has two given nodes as descendants.",
  "hint": "Use BST ordering to move left, move right, or stop when the two targets split around the current node.",
  "quickAnswer": {
    "pattern": "BST Search",
    "idea": [
      "BST ordering tells which side contains both nodes.",
      "Move left if both values are smaller.",
      "Move right if both are larger; otherwise current is LCA."
    ],
    "complexity": {
      "time": "O(h)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Start at the root.",
    "If both target values are smaller, move left.",
    "If both target values are larger, move right.",
    "Otherwise the current node is where the paths split.",
    "Return that split node as the lowest common ancestor."
  ],
  "pseudocode": [
    "node = root",
    "",
    "while node exists:",
    "    if both targets are smaller:",
    "        node = node.left",
    "    else if both targets are larger:",
    "        node = node.right",
    "    else:",
    "        return node"
  ],
  "complexity": {
    "time": "O(h)",
    "space": "O(1)"
  },
  "edgeCases": [
    "One target is the ancestor of the other.",
