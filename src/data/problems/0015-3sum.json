    "sort nums",
    "answers = empty list",
    "",
    "for each anchor index:",
    "    if duplicate anchor:",
    "        continue",
    "",
    "    left = anchor + 1",
    "    right = last index",
    "",
    "    while left < right:",
    "        sum = anchor + left + right",
