        "function insert(intervals, newInterval) {",
        "  const result = [];",
        "  let i = 0;",
        "  while (i < intervals.length && intervals[i][1] < newInterval[0]) result.push(intervals[i++]);",
        "  while (i < intervals.length && intervals[i][0] <= newInterval[1]) { newInterval[0] = Math.min(newInterval[0], intervals[i][0]); newInterval[1] = Math.max(newInterval[1], intervals[i][1]); i += 1; }",
        "  result.push(newInterval);",
        "  while (i < intervals.length) result.push(intervals[i++]);",
        "  return result;",
        "}"
