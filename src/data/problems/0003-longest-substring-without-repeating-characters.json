  "summary": "Return the length of the longest contiguous substring that contains no repeated characters.",
  "hint": "Move the left side of the window only when a repeated character is inside the current window.",
  "approach": [
    "Track the last index where each character appeared.",
    "Expand the right side of the window one character at a time.",
    "If the character was seen inside the current window, move left after its previous index.",
    "Update the character's latest index.",
    "Record the best window length after each step."
  ],
