  "summary": "For each index, compute the product of every other number without using division.",
  "hint": "Store prefix products in the output, then multiply by a running suffix product from the right.",
  "quickAnswer": {
    "pattern": "Prefix / Suffix",
    "idea": [
      "Output first stores products to the left.",
      "A backward pass multiplies products to the right.",
      "No division is needed."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Fill the result with products of all values to the left of each index.",
    "Scan from right to left with a running suffix product.",
    "Multiply each result entry by the current suffix.",
    "Update the suffix with the current number.",
    "The result array is the required output."
  ],
  "pseudocode": [
    "answer = ones array",
    "prefix = 1",
    "",
    "for each index left to right:",
    "    answer[index] = prefix",
    "    prefix *= nums[index]",
    "",
    "suffix = 1",
    "for each index right to left:",
    "    answer[index] *= suffix",
    "    suffix *= nums[index]",
    "",
    "return answer"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "The input contains zero.",
    "The input contains multiple zeros.",
    "Negative values change product signs.",
    "The array has two elements."
