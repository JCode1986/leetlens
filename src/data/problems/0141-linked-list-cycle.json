  "summary": "Determine whether a linked list contains a cycle.",
  "hint": "Move one pointer twice as fast as the other; a cycle makes them meet.",
  "quickAnswer": {
    "pattern": "Fast / Slow Pointers",
    "idea": [
      "Move slow by one and fast by two.",
      "A cycle makes the pointers meet.",
      "A null fast pointer means no cycle."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Start slow and fast pointers at the head.",
    "Move slow one step and fast two steps.",
    "If the pointers meet, a cycle exists.",
    "If fast reaches the end, there is no cycle.",
    "This uses constant extra memory."
  ],
  "pseudocode": [
    "slow = head",
    "fast = head",
    "",
    "while fast and fast.next exist:",
    "    slow = slow.next",
    "    fast = fast.next.next",
    "",
    "    if slow is fast:",
    "        return true",
    "",
    "return false"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "The list is empty.",
    "The list has one node with no cycle.",
    "The tail connects to the head.",
    "The cycle begins in the middle."
  ],
