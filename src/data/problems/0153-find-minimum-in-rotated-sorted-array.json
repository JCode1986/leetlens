  "summary": "Find the smallest value in a sorted array that has been rotated.",
  "hint": "Compare the middle value with the right edge to decide which half contains the minimum.",
  "quickAnswer": {
    "pattern": "Binary Search",
    "idea": [
      "The minimum is in the unsorted half.",
      "Compare middle with right edge.",
      "Shrink toward the rotation point."
    ],
    "complexity": {
      "time": "O(log n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Keep left and right bounds around the possible minimum.",
    "Find the middle index.",
    "If nums[mid] is greater than nums[right], the minimum is to the right.",
    "Otherwise the minimum is at mid or to the left.",
    "When bounds meet, that index holds the minimum."
  ],
  "pseudocode": [
    "left = 0",
    "right = last index",
    "",
    "while left < right:",
    "    mid = middle index",
    "",
    "    if nums[mid] > nums[right]:",
    "        left = mid + 1",
    "    else:",
    "        right = mid",
    "",
    "return nums[left]"
  ],
  "complexity": {
    "time": "O(log n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "The array is not rotated.",
    "The array has one element.",
    "The pivot is near either end.",
    "The minimum is at index zero."
  ],
  "solutions": {
    "javascript": {
      "desktop": [
        "function findMin(nums) {",
        "  let left = 0;",
        "  let right = nums.length - 1;",
        "",
        "  while (left < right) {",
        "    const mid = Math.floor((left + right) / 2);",
        "    if (nums[mid] > nums[right]) {",
        "      left = mid + 1;",
        "    } else {",
        "      right = mid;",
        "    }",
        "  }",
        "",
        "  return nums[left];",
        "}"
      ],
