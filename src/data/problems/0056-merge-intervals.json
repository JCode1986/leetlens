    "javascript": {
      "desktop": [
        "function merge(intervals) {",
        "  intervals.sort((a, b) => a[0] - b[0]);",
        "  const result = [];",
        "  for (const cur of intervals) {",
        "    if (!result.length || result[result.length - 1][1] < cur[0]) result.push([...cur]);",
        "    else result[result.length - 1][1] = Math.max(result[result.length - 1][1], cur[1]);",
        "  }",
        "  return result;",
        "}"
      ],
