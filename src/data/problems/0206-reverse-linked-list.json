  "solutions": {
    "javascript": {
      "desktop": [
        "function reverseList(head) {",
        "  let prev = null;",
        "  let current = head;",
        "",
        "  while (current !== null) {",
        "    const next = current.next;",
        "    current.next = prev;",
        "    prev = current;",
        "    current = next;",
        "  }",
        "",
        "  return prev;",
        "}"
      ],
