  "summary": "Reverse a singly linked list in place and return the new head node.",
  "hint": "Keep the previous node, redirect the current node's next pointer, then advance.",
  "quickAnswer": {
    "pattern": "Pointer Reversal",
    "idea": [
      "Keep previous, current, and next pointers.",
      "Redirect current.next to previous.",
      "Advance until current is null."
    ],
    "complexity": {
      "time": "O(n)",
      "space": "O(1)"
    }
  },
  "approach": [
    "Start with prev as null and current as the head.",
    "Save current.next before changing pointers.",
    "Point current.next back to prev.",
    "Move prev and current one node forward.",
    "When current is null, prev is the new head."
  ],
  "pseudocode": [
    "previous = null",
    "current = head",
    "",
    "while current exists:",
    "    nextNode = current.next",
    "    current.next = previous",
    "    previous = current",
    "    current = nextNode",
    "",
    "return previous"
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "edgeCases": [
    "The list is empty.",
    "The list has one node.",
    "The list has two nodes.",
    "The original head must become the tail and point to null.",
    "All nodes must remain reachable after reversal."
