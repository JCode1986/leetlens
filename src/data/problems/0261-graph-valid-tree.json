        "    def validTree(self, n, edges):",
        "        if len(edges) != n - 1: return False",
        "        parent = list(range(n))",
        "        def find(x):",
        "  while parent[x] != x:",
        "      parent[x] = parent[parent[x]]; x = parent[x]",
        "  return x",
        "        for a, b in edges:",
        "  ra, rb = find(a), find(b)",
        "  if ra == rb: return False",
        "  parent[ra] = rb",
