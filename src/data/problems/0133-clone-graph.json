      "desktop": [
        "function cloneGraph(node) { if(!node) return null; const seen = new Map(); function dfs(cur){ if(seen.has(cur)) return seen.get(cur); const copy = new Node(cur.val); seen.set(cur, copy); for(const nei of cur.neighbors) copy.neighbors.push(dfs(nei)); return copy; } return dfs(node); }"
